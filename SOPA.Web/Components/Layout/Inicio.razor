@page "/"
@namespace SOPA.Web.Components.Pages
@layout SOPA.Web.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Authorization

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="text-center mb-5">
        <div class="bg-primary text-white d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-heart-fill fs-2"></i>
        </div>
        <h1 class="display-4 fw-bold text-primary">SOPA</h1>
        <p class="lead text-muted">Sociedade Protetora dos Animais — Sistema de Voluntariado</p>
    </div>

    <div class="card shadow p-4 text-center" style="width: 100%; max-width: 400px; border-radius: 15px;">
        <h5 class="mb-4 fw-semibold text-secondary">Bem-vindo(a)! O que deseja fazer?</h5>

        <div class="d-grid gap-3">
            <a href="/login" class="btn btn-primary btn-lg fw-bold py-2 shadow-sm">
                <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sessão
            </a>

            <a href="/registrar" class="btn btn-outline-primary btn-lg fw-bold py-2">
                <i class="bi bi-person-plus me-2"></i> Cadastrar Novo Voluntário
            </a>
        </div>
    </div>

    <div class="text-center mt-5 text-muted small">
        <p>&copy; 2026 SOPA Bicas - MG. Todos os direitos reservados.</p>
    </div>
</div>